#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Emit a reproducibility buildinfo for a built image -- the image-level analogue
## of a Debian '.buildinfo'. It records the PARAMETERS needed to reproduce the
## image so a verifier needs no flags: given the image URL it fetches the sibling
## '<image>.dm-buildinfo' (+ signatures), and rebuilds from the recorded
## parameters. See 'dm-reproducible-verify'.
##
## No standardized image-level buildinfo format exists (Debian '.buildinfo' is
## package-only; Tails, Guix, mkosi, osbuild each rolled their own), so this is a
## small signed Deb822 file modeled on Debian '.buildinfo' conventions and the
## live-build 'summary.txt' that 'live-build/test/rebuild.sh' already emits.
##
## Extension is '.dm-buildinfo', deliberately NOT '.buildinfo': it must not
## shadow Debian's package '.buildinfo' (nor collide with an image-level
## '.buildinfo' should Debian standardize one later). 'dm-' namespaces it to
## derivative-maker, and '*.buildinfo' globs do not match '*.dm-buildinfo'.
##
## Intentionally records NO checksum: 'dm-prepare-release' already writes and
## signs '<image>.sha512sums' in the same folder -- the buildinfo must not
## duplicate it. This script also does NOT sign: the buildinfo is added to
## 'dm-prepare-release's signature set so it is signed and verified by the SAME
## 'sign_and_verify' function as every other release artifact (both OpenPGP
## '.asc' and signify '.sig'); no 'sq'/'signify' is invoked here.
##
## The build metadata is read from the environment the build already exports
## (dist_build_flavor, dist_build_target_arch, ...), so wiring this into the
## build is a single call per built image.
##
## Usage:
##   dm-reproducible-buildinfo --target TARGET --image IMAGE_PATH [--output FILE]
##
## Exit codes: 0 written; 2 usage/environment error.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

error() {
   printf '%s\n' "ERROR: $*" >&2
   exit 2
}

target=""
image=""
output=""
dry_run="false"

while [ "$#" -gt 0 ]; do
   case "${1:-}" in
      --target)
         [ "$#" -ge 2 ] || error "--target requires a value."
         target="$2"
         shift 2
         ;;
      --image)
         [ "$#" -ge 2 ] || error "--image requires a value."
         image="$2"
         shift 2
         ;;
      --output)
         [ "$#" -ge 2 ] || error "--output requires a value."
         output="$2"
         shift 2
         ;;
      --dry-run)
         ## Emit the record WITHOUT requiring the image to exist. Every field but
         ## Image-File comes from the environment and the pre-sign source-state
         ## file, both of which exist seconds into a build -- so the whole record
         ## is derivable long before the artifact is. Without this, observing a
         ## change to this file costs a full build (~60 min) or ci/dry-run
         ## (~36 min, measured); with it, ~12 ms.
         ##
         ## It skips ONLY the existence check: the same code produces the same
         ## fields by the same path, so what it emits is what a real run emits.
         ## Image-File still comes from --image, which is why --image stays
         ## required -- a record naming no artifact would be a different record.
         dry_run='true'
         shift
         ;;
      -h|--help)
         grep '^##' -- "${BASH_SOURCE[0]}" | sed 's/^## \{0,1\}//'
         exit 0
         ;;
      *)
         error "unknown argument: '$1'."
         ;;
   esac
done

[ -n "${target}" ] || error "--target is required."
[ -n "${image}" ]  || error "--image is required."
if [ "${dry_run}" = 'true' ]; then
   [ -f "${image}" ] || printf '%s\n' "INFO: --dry-run: '${image}' does not exist; emitting the record anyway." >&2
else
   [ -f "${image}" ] || error "image does not exist: '${image}'"
fi
[ -n "${output}" ] || output="${image}.dm-buildinfo"

## Read a build-exported variable; 'unknown' when unset so the record is always
## well-formed (the verifier validates the ones it needs to rebuild).
val() { local v="${!1:-}"; printf '%s' "${v:-unknown}"; }

## The source state recorded by help-steps/sign-and-tag BEFORE it amended
## anything. It has to come from there: sign-tag-head rewrites the parent's HEAD
## and every submodule's HEAD, and those commits exist only inside that build, so
## reading them here would publish a signed record pointing at commits nobody can
## fetch. It also carries the submodule SHAs the build actually used, which CI's
## fork-branch checkout resolves from moving branch tips and records nowhere else.
source_state_file="${dm_source_state_file:-}"
if [ -z "${source_state_file}" ] && [ -n "${binary_build_folder_dist:-}" ]; then
   source_state_file="${binary_build_folder_dist}/dm-source-state"
fi

## Say so in the record rather than silently emitting 'unknown': an absent or
## unusable state file means the image was built by a path that did not record
## its provenance, and a verifier needs to know that is why, not guess.
state_unrecorded() {
   printf '%s\n' "Source-Commit: unrecorded ($1)" "Submodule-State: unrecorded"
}

## Readability is not enough. This block is interpolated INTO the Deb822 record
## below, where a blank line is the record TERMINATOR -- so an empty or partial
## file does not merely lose provenance, it truncates the record and detaches
## every field after it into an invalid paragraph. Content is therefore
## validated, and anything short of both records is reported as unrecorded.
source_state_block=""
if [ -z "${source_state_file}" ]; then
   ## Without this, an unset binary_build_folder_dist yields the absolute path
   ## '/dm-source-state' and this reads whatever happens to sit in the root
   ## directory.
   source_state_block="$(state_unrecorded "neither dm_source_state_file nor binary_build_folder_dist is set")"
elif [ ! -f "${source_state_file}" ] || [ ! -r "${source_state_file}" ]; then
   source_state_block="$(state_unrecorded "help-steps/sign-and-tag did not run, or wrote no ${source_state_file}")"
else
   source_state_candidate="$(cat -- "${source_state_file}")"
   state_reject=""
   case "${source_state_candidate}" in
      "")
         state_reject="${source_state_file} is empty"
         ;;
      *$'\n\n'*)
         state_reject="${source_state_file} contains a blank line, which would terminate this Deb822 record"
         ;;
   esac
   if [ -z "${state_reject}" ]; then
      case "${source_state_candidate}" in
         "Source-Commit: "*)
            true
            ;;
         *)
            state_reject="${source_state_file} does not start with a Source-Commit field"
            ;;
      esac
   fi
   if [ -z "${state_reject}" ]; then
      case "${source_state_candidate}" in
         *"Submodule-State:"*)
            true
            ;;
         *)
            state_reject="${source_state_file} carries no Submodule-State field"
            ;;
      esac
   fi
   if [ -n "${state_reject}" ]; then
      source_state_block="$(state_unrecorded "${state_reject}")"
   else
      source_state_block="${source_state_candidate}"
   fi
fi

## Source-Version and the recorded Source-Commit MUST name the same commit.
##
## They are produced independently: Source-Commit comes from the pre-sign state
## file that help-steps/sign-and-tag wrote, while 'dist_build_version' is
## auto-detected by help-steps/variables ONLY when unset -- so a value inherited
## from the environment silently wins over the actual tree. An observed record
## carried Source-Commit 02096cd4... beside Source-Version ...-ge65ff458..., i.e.
## two DIFFERENT commits in one record, from a reused workspace holding a stale
## dist_build_version. A rebuild keyed on either field then reproduces the wrong
## tree, which is exactly what this record exists to prevent.
##
## 'git describe' ends in '-g<sha>' and that sha IS the described commit, so when
## the suffix is present it must equal Source-Commit. A clean tag build carries no
## suffix, and an 'unrecorded' state block has nothing to compare -- neither is
## constrained.
recorded_commit=""
case "${source_state_block}" in
   "Source-Commit: unrecorded"*)
      ;;
   "Source-Commit: "*)
      recorded_commit="${source_state_block#Source-Commit: }"
      recorded_commit="${recorded_commit%%$'\n'*}"
      ;;
esac

described_commit=""
case "${dist_build_version:-}" in
   *-g*)
      described_commit="${dist_build_version##*-g}"
      ;;
esac
## Non-hex means this is not a describe suffix (a tag may legitimately contain
## '-g'), so there is nothing to compare.
case "${described_commit}" in
   *[!0-9a-f]*|"")
      described_commit=""
      ;;
esac

if [ -n "${recorded_commit}" ] && [ -n "${described_commit}" ] \
   && [ ! "${described_commit}" = "${recorded_commit}" ]; then
   error "Source-Version and Source-Commit disagree -- this record would point a rebuild at the wrong tree.
  Source-Version: ${dist_build_version}
    (describes:   ${described_commit})
  Source-Commit:  ${recorded_commit}
  'dist_build_version' is auto-detected only when UNSET, so a value inherited from
  the environment overrides the real HEAD. Unset it, or set it to match this commit."
fi

## Deb822 (RFC822-style): greppable, signable, and the shop's idiom. The trailing
## blank line is the Deb822 record terminator. Fields follow Debian '.buildinfo'
## + live-build 'summary.txt' + the Tails apt-snapshot-pinning discipline.
##  - Source-Commit + Source-Version pin the derivative-maker tree.
##  - Debian-Suite + APT-Snapshot pin the package world (determinism).
##  - Source-Date-Epoch is derived from debian/changelog, so a rebuild from the
##    same Source-Commit reproduces it automatically.
##  - Flavor/Target/Build-Type/Architecture/Freedom are the build selectors a
##    rebuild replays; NO checksum (see header).
printf '%s\n' "\
Format: 1.0
Buildinfo-Type: derivative-image
Source-Repo: $(val project_clearnet)
${source_state_block}
Source-Version: $(val dist_build_version)
Flavor: $(val dist_build_flavor)
Target: ${target}
Build-Type: $(val dist_build_type)
Architecture: $(val dist_build_target_arch)
Freedom: $(val build_freedom_only)
Debian-Suite: $(val dist_build_apt_stable_release)
APT-Snapshot: $(val dist_build_apt_sources_mirror)
Source-Date-Epoch: $(val SOURCE_DATE_EPOCH)
Image-File: $(basename -- "${image}")
" > "${output}"

printf '%s\n' "INFO: wrote buildinfo -> ${output}" >&2
printf '%s\n' "INFO: register '${output}' with dm-prepare-release so it is signed alongside the image." >&2
