#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/log_run_die.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh

## A unicode-spoofing scan that exits non-zero found a look-alike (or hit a
## benign failure such as check-ref-names-for-unicode's "No refs matched").
## Rather than hard-abort the whole review under errexit, let the operator
## decide -- same 'log question' + read-from-/dev/tty consent as
## git_review_prompt_continue (git-review-scan.sh). No controlling terminal to
## ask (a CI/batch run): fail closed.
review_scan_or_prompt() {
   local scan_rc reply
   scan_rc=0
   "$@" || scan_rc="$?"
   if [ "${scan_rc}" -eq 0 ]; then
      return 0
   fi
   if ! { true < /dev/tty ; } 2>/dev/null ; then
      die "${scan_rc}" "'${1}' failed (rc='${scan_rc}') and there is no terminal to ask; failing closed."
   fi
   log warn "'${1}' failed (rc='${scan_rc}') -- possible unicode spoofing."
   log question "Continue the review anyway? [y/N]"
   reply=''
   read -r reply < /dev/tty 2>/dev/null || reply=''
   if [ "${reply,,}" != 'y' ] && [ "${reply,,}" != 'yes' ]; then
      die "${scan_rc}" "aborting the review at your request."
   fi
   log info "continuing despite '${1}' (rc='${scan_rc}')."
}

## Scan the ref's new commits (content, messages, author identity)...
review_scan_or_prompt check-ref-commits-for-unicode "${1}"

## ...and every ref NAME in the repo, for spoofing via non-ASCII unicode.
## check-ref-names-for-unicode takes ref-name GLOBS (git for-each-ref), not a
## single ref -- with no argument it scans all refs (its documented default).
## Passing the reviewed ref instead would only check that one name (missing a
## spoofed sibling), and a look-alike name would make for-each-ref fail to
## match ("No refs matched") rather than be flagged as suspicious. Scanning
## every ref catches a spoofed name anywhere the fetch introduced one.
review_scan_or_prompt check-ref-names-for-unicode

git log "...${1}"

git-diff-review "...${1}"

git-meld "...${1}"

git-kdiff3 "...${1}"

true "$0: OK."
