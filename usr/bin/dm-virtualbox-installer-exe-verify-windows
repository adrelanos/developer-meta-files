#!/bin/bash

## Copyright (C) 2023 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

#### meta start
#### project Kicksecure
#### category security
#### description

## Verifies the integrity of VirtualBox.exe.
## This script assumes that the calling script previously changed directory
## into the folder which contains the VirtualBox.exe.

#### meta end

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/has.sh
## Fail with a NAMED dependency error. With HELPER_SCRIPTS_PATH unset the
## '${VAR:-}' below resolves to the ABSOLUTE /usr/libexec/... path, so an
## absent helper-scripts dies as a bare "No such file or directory" that names
## neither the package nor the fix.
helper_scripts_preflight() {
   local helper_scripts_probe
   helper_scripts_probe="${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/has.sh"
   if [ ! -r "${helper_scripts_probe}" ]; then
      printf '%s\n' "${0##*/}: ERROR: helper-scripts not found at '${helper_scripts_probe}' -- install the helper-scripts package, or set HELPER_SCRIPTS_PATH to a checkout." >&2
      exit 1
   fi
}
helper_scripts_preflight

source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.sh

true "$0: START"

pwd

has osslsigncode
has sha256sum

counter=0
selected_file_name=""
for file_name in ./VirtualBox-*.exe ; do
  ## Default glob behaviour: with no matches the pattern is left
  ## literal, so guard against that explicitly. Also guard against
  ## accidentally matched directory names.
  test -f "${file_name}" || continue
  selected_file_name="${file_name}"
  counter=$((counter + 1))
done

if [ "${counter}" -eq "0" ]; then
  true "$0: ERROR: No file matching VirtualBox-*.exe!"
  exit 1
fi
if [ "${counter}" -gt "1" ]; then
  true "$0: ERROR: Multiple files matching VirtualBox-*.exe!"
  exit 1
fi

test -r "${selected_file_name}"

osslsigncode verify -in "${selected_file_name}"

sha256sum --ignore-missing --strict --check SHA256SUMS

true "$0: SUCCESS"
