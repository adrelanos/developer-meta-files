## AI-Assisted

# shellcheck shell=bash

## style-ok: no-strict -- sourced library; a strict-mode preamble would leak
## errexit/nounset into the caller's shell.

## Reusable per-package rebuild detection: is a package already published in the
## local reprepro repository at its current 'debian/changelog' version? Uses the
## same changelog-version-vs-published-version mechanism as
## 'dm-packaging-helper-script' (dpkg --compare-versions against the source
## version reprepro reports), so a build can skip packages that have not been
## version-bumped since the last build.

## Echo the source version currently published for a package in the local
## reprepro repository, or nothing if the package is absent.
##   dm_reprepro_published_source_version <apt_codename> <source_pkg> <repository_name>
## 'derivative_repository_name' selects the reprepro folder; it is exported only
## inside the command substitution's subshell so it does not leak to the caller.
dm_reprepro_published_source_version() {
   local apt_codename source_pkg repository_name query_output source_line
   local source_matches source_grep_rc
   local -a fields
   apt_codename="$1"
   source_pkg="$2"
   repository_name="$3"

   query_output="$(
      export derivative_repository_name="${repository_name}"
      "${dist_developer_meta_files_folder}/usr/bin/dm-reprepro-wrapper" \
         --architecture source list "${apt_codename}" "${source_pkg}" 2>/dev/null || true
   )"

   ## reprepro reports e.g.: local|main|source: sdwdate 1.2.3-1
   ## Match the literal '|source: ' FIELD rather than a bare 'source:' anywhere in the line,
   ## and take the FIRST match explicitly -- reprepro prints one line per component, so a
   ## package published in more than one yields several and the 'read' below would silently
   ## consume only one of them regardless.
   ## Split into steps: one pipeline plus a substitution plus a blanket
   ## '|| true' made every failure look identical, and 'head' closing the pipe
   ## early can kill grep with SIGPIPE (rc 141 under pipefail), which the
   ## '|| true' then hid as well. Separating them also distinguishes grep's
   ## "no match" (rc 1) from a real error (rc >1), which must not be silently
   ## treated as "not published".
   source_grep_rc=0
   source_matches="$(printf '%s\n' "${query_output}" | grep --fixed-strings -- "|source: ")" \
      || source_grep_rc="$?"
   if [ "${source_grep_rc}" -gt 1 ]; then
      printf '%s\n' "${FUNCNAME[0]}: ERROR: reprepro output could not be searched (grep exit ${source_grep_rc})." >&2
      return 1
   fi
   [ -n "${source_matches}" ] || return 0
   source_line="$(printf '%s\n' "${source_matches}" | head --lines=1)"
   [ -n "${source_line}" ] || return 0
   read -r -a fields <<< "${source_line}"
   ## Expect exactly '<codename>|<component>|source:' '<pkg>' '<version>'. Taking the LAST
   ## token blindly meant an added field in a future reprepro output format would be returned
   ## as if it were the version, and dpkg --compare-versions would then act on garbage.
   ## Report "not published" instead, which errs toward rebuilding.
   [ "${#fields[@]}" -eq 3 ] || return 0
   printf '%s\n' "${fields[2]}"
}

## Deterministic content hash of a package source tree: every non-VCS file's path
## AND content. Detects an edit that did NOT bump debian/changelog, so local debug
## builds rebuild exactly the changed packages -- no package names, no changelog.
## Content alone is not enough. 'find -type f' does not match SYMLINKS at all, and sha256sum
## hashes bytes only, so retargeting a symlink or a chmod produced an IDENTICAL hash and the
## rebuild gate skipped a package that really had changed. Three streams are folded in:
## entry type + mode + path for every entry, symlink targets, and regular-file content.
dm_package_source_hash() {
   local package_source_dir="$1"
   ( cd -- "${package_source_dir}" 2>/dev/null || exit 1
     {
        ## Type, permission bits and path of EVERY entry, so a chmod, a new empty directory,
        ## or a file replaced by a symlink all move the digest. NUL-terminated and sorted
        ## under LC_ALL=C so the result is deterministic and safe for odd filenames.
        find . -path './.git' -prune -o -printf '%y %m %p\0' | LC_ALL=C sort -z
        ## Symlink TARGETS, which no amount of content hashing can see.
        find . -path './.git' -prune -o -type l -printf '%p -> %l\0' | LC_ALL=C sort -z
        ## Regular-file content, as before.
        find . -path './.git' -prune -o -type f -print0 \
           | LC_ALL=C sort -z \
           | xargs -0 -r sha256sum
     } | sha256sum | cut -d ' ' -f 1
   ) || printf '%s\n' "nohash"
}

## Per-codename source-hash manifest. Kept under binary_build_folder_dist, which
## is per-build-slot ('derivative-binary/<slot>'), co-located with that slot's
## local reprepro repo -- so it is NOT shared across build slots (a package
## published in one slot's repo must not read as up-to-date in another). Placed in
## a dedicated 'packages-build-status' subfolder rather than the build-folder root.
dm_source_hash_manifest_path() {
   printf '%s\n' "${binary_build_folder_dist}/packages-build-status/source-hashes.${1}.txt"
}

## Manifest lines are written by dm_source_hash_record below as '<source_pkg> <hash>', one
## space, never any other whitespace -- so splitting on the FIRST space is exact, and both
## helpers below compare the package with '=' rather than any pattern syntax. That exactness
## is the point: 'grep -v -- "^${source_pkg} "' read the name as a basic regular expression,
## where '.' matches any character, so recording a hash for 'foo.bar' silently dropped an
## unrelated 'fooXbar' entry.

## Look up the recorded source hash for a source package (empty if none).
dm_source_hash_lookup() {
   local manifest="$1" source_pkg="$2" line manifest_pkg manifest_hash
   [ -f "${manifest}" ] || return 0
   ## '|| [ -n "${line}" ]' so a final line with no trailing newline is still examined.
   while IFS= read -r line || [ -n "${line}" ]; do
      manifest_pkg="${line%% *}"
      if [ "${manifest_pkg}" = "${source_pkg}" ]; then
         manifest_hash="${line#* }"
         printf '%s\n' "${manifest_hash%% *}"
         return 0
      fi
   done < "${manifest}"
   return 0
}

## Record/replace a source package's hash in the manifest (call after publishing).
dm_source_hash_record() {
   local manifest="$1" source_pkg="$2" hash="$3" tmp line manifest_pkg
   mkdir --parents -- "$(dirname -- "${manifest}")"
   tmp="$(mktemp)"
   if [ -f "${manifest}" ]; then
      while IFS= read -r line || [ -n "${line}" ]; do
         manifest_pkg="${line%% *}"
         if [ "${manifest_pkg}" = "${source_pkg}" ]; then
            continue
         fi
         ## Echo the line VERBATIM rather than reassembling it from fields, so an entry this
         ## function does not own is never reformatted.
         printf '%s\n' "${line}"
      done < "${manifest}" > "${tmp}"
   fi
   printf '%s %s\n' "${source_pkg}" "${hash}" >> "${tmp}"
   mv -- "${tmp}" "${manifest}"
}

## Decide whether a package source tree needs (re)building.
##   dm_package_needs_rebuild <package_source_dir> <apt_codename> <repository_name>
## Return 0 (needs rebuild) when the package is absent, its changelog version
## differs from the published one, OR -- for an already-published same version --
## its source CONTENT changed since it was last built (edit without a changelog
## bump, detected by a content-hash manifest). Return 1 (skip) only when the
## published version matches AND the source hash is unchanged.
dm_package_needs_rebuild() {
   local package_source_dir apt_codename repository_name
   local changelog_version source_pkg published_version
   local manifest current_hash stored_hash
   package_source_dir="$1"
   apt_codename="$2"
   repository_name="$3"

   changelog_version="$(dpkg-parsechangelog --show-field Version --file "${package_source_dir}/debian/changelog")"
   source_pkg="$(dpkg-parsechangelog --show-field Source --file "${package_source_dir}/debian/changelog")"

   published_version="$(dm_reprepro_published_source_version "${apt_codename}" "${source_pkg}" "${repository_name}")"

   ## Absent or a different changelog version -> rebuild.
   if [ -z "${published_version}" ] || ! dpkg --compare-versions "${changelog_version}" eq "${published_version}"; then
      true "INFO: rebuild ${source_pkg}: changelog ${changelog_version}, published ${published_version:-none}."
      return 0
   fi

   ## Same version already published: rebuild only if the source content changed
   ## since it was last built. Unknown (no manifest entry) is treated as changed,
   ## so a first build after adopting this repopulates the manifest safely.
   manifest="$(dm_source_hash_manifest_path "${apt_codename}")"
   current_hash="$(dm_package_source_hash "${package_source_dir}")"
   stored_hash="$(dm_source_hash_lookup "${manifest}" "${source_pkg}")"
   if [ -z "${stored_hash}" ] || [ "${stored_hash}" != "${current_hash}" ]; then
      true "INFO: rebuild ${source_pkg}: source content changed since last build (hash mismatch)."
      return 0
   fi

   true "INFO: skip ${source_pkg}: version ${changelog_version} published and source unchanged."
   return 1
}
